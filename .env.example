# Copy to .env.local for local work. Never commit real values.

# Supabase project for the College Club (Project Settings > API)
SUPABASE_URL=https://hgjcnuwxhemynnvsnmou.supabase.co
# Secret server key. Keep it out of chat, email and the browser. Only set it in Vercel or .env.local.
SUPABASE_SERVICE_ROLE_KEY=

# Leave unset in production. With no Supabase values, local development shows made-up sample data.
# CCS_ALLOW_SAMPLE_DATA=1

# Mailchimp (read-only reports). Put the API key only in Vercel or .env.local, never in chat.
# MAILCHIMP_API_KEY=
# MAILCHIMP_LIST_ID=f5e1cad862
# MAILCHIMP_SINCE=2022-01-01

# --- Member / reservation system (test build; see CLAUDE.md) ---
# The member area at /club shows only invented households. It exists while developing, or when
# CCS_ALLOW_SAMPLE_DATA=1 (set that in Vercel PREVIEW only), and never on the live production site.
# The member system's database. LOCAL or throwaway databases only (Supabase CLI: `supabase start`); the app refuses
# any address that looks like a hosted Supabase project. With this set, /club reads and writes Postgres instead of the
# in-memory sample. With CCS_ALLOW_SAMPLE_DATA=1 as well, the invented sample club is loaded the first time, if (and only
# if) the database has no households yet. Apply supabase/migrations first (`supabase db reset` does).
# CLUB_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Used only by the automated tests (database rules, the Postgres store, and the browser tests against Postgres). Points at a
# local or throwaway Postgres; tests refuse Supabase addresses.
# CLUB_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Freezes "now" for the member area (development and tests only), e.g. 2026-10-28T20:00:00Z. Leave unset otherwise.
# CCS_CLUB_NOW=
# The secret behind personal RSVP links in emails (step 4). At least 16 random characters; keep it out of chat, email and the
# browser. Set it wherever links must keep working across restarts and servers (for example Vercel PREVIEW). With it unset the
# invented-data build makes a random one per server process, so links only work on that server until it restarts.
# CLUB_LINK_SECRET=
